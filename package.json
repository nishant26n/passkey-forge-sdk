{
  "name": "use-passkey",
  "version": "0.1.1",
  "description": "A framework-agnostic React hook for WebAuthn/passkey registration and login, wrapping @simplewebauthn/browser against a REST contract any backend can implement.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./components/style.css": "./dist/components.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "size-limit": [
    {
      "name": "index (headless hooks)",
      "path": "dist/index.js",
      "limit": "6 KB"
    },
    {
      "name": "components",
      "path": "dist/components.js",
      "limit": "18 KB"
    }
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.1",
    "react": "^19",
    "react-dom": "^19",
    "semantic-release": "^24.2.9",
    "size-limit": "^11.2.0",
    "storybook": "^9.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^6",
    "vitest": "^4.1.11"
  }
}
